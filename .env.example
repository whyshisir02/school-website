# Database (Neon/Supabase free tier)
DATABASE_URL="postgresql://user:password@host:5432/school?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/school?schema=public"

# NextAuth
NEXTAUTH_URL="https://your-site.netlify.app"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Admin seed credentials
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="set-a-strong-password-locally"

# Cloudinary (gallery uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# School contact (used in forms/footer)
NEXT_PUBLIC_SCHOOL_PHONE="+977-9800000000"
NEXT_PUBLIC_SCHOOL_EMAIL="info@example.com"
