# Database (Neon/Supabase free tier)
DATABASE_URL="postgresql://user:password@host:5432/school?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/school?schema=public"

# NextAuth
NEXTAUTH_URL="https://your-site.netlify.app"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Canonical public origin — used by metadataBase, sitemap.xml and robots.txt.
# Set this and NEXTAUTH_URL to the same school deployment origin.
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"

# Cloudinary (gallery uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Explicit folder required by initialize-school.ts (existing deployments default to eastern-view).
CLOUDINARY_FOLDER="your-school"

# School contact and branding are configured in Super Admin settings.

# Maintainer-only optional settings (do not expose to school admins):
# BACKUP_DATABASE_URL="direct/session connection if different from DIRECT_URL"
# RESTORE_DATABASE_URL="separate EMPTY recovery database; never the live database"
# PG_BIN="path to PostgreSQL tools when not on PATH"
# ALLOW_ISOLATED_PREVIEW="1" # only after configuring separate preview services
