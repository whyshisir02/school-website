// This is a Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum NoticeCategory {
  EXAM
  HOLIDAY
  EVENT
  GENERAL
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String    @default("")
  passwordHash   String
  passwordReady  Boolean   @default(true)
  role           String    @default("ADMIN")
  permissions    String[]  @default(["GALLERY", "NOTICES", "FACULTY"])
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  // Bumped to invalidate every issued JWT at once ("log out all devices" and on
  // password change). Each token carries the version it was minted with; a
  // request whose token.ver != this value is treated as signed out. See auth.ts.
  tokenVersion   Int       @default(0)
  createdAt      DateTime  @default(now())
  setupTokens    AccountSetupToken[]
}

model AccountSetupToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenVersion Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorEmail String
  actorRole  String
  action     String
  area       String
  targetId   String?
  details    Json

  @@index([createdAt, id])
  @@index([area, createdAt, id])
}

model Notice {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  content     String         @db.Text
  category    NoticeCategory @default(GENERAL)
  isPublished Boolean        @default(false)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isPublished, publishedAt])
}

model GalleryAlbum {
  id         String        @id @default(cuid())
  title      String
  slug       String        @unique
  coverImage String?
  images     GalleryImage[]
  createdAt  DateTime      @default(now())
}

model GalleryImage {
  id       String       @id @default(cuid())
  albumId  String
  album    GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url      String
  publicId String? // Cloudinary public_id for deletion
  caption  String?
  eventBsYear Int? // Year the photographed event happened, not the upload year
  order    Int          @default(0)
  createdAt DateTime    @default(now())

  @@index([albumId, createdAt, id])
  @@index([createdAt, id])
  @@index([eventBsYear, createdAt, id])
  @@index([albumId, eventBsYear, createdAt, id])
}

model Settings {
  announcement Json? // saved draft and published image popup
  branding   Json?   // school identity and public copy, managed by Super Admin
  id         String  @id @default("main")
  schoolName String
  address    String
  phone      String
  email      String
  mapLink    String?
  mapEmbed   String? // live Google Maps iframe src (embed URL)
  stats      Json?   // homepage stat tiles: [{ value, label, show }]
  principal  Json?   // { excerpt, messageHtml } — home quote + full About letter
  chairman   Json?   // { name, title, messageHtml } — About chairman message
  heroSlides Json?   // homepage hero photos: [{ url, alt, publicId?, objectPosition? }]
  principalStaffId String?
  principalStaff StaffMember? @relation(fields: [principalStaffId], references: [id], onDelete: SetNull)
}

enum StaffGroup {
  LEADERSHIP
  TEACHING
  SUPPORT
}

enum StaffStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model StaffMember {
  id             String @id @default(cuid())
  name           String
  position       String
  group          StaffGroup @default(TEACHING)
  status         StaffStatus @default(DRAFT)
  subject        String @default("")
  qualifications String @default("")
  bio            String @default("") @db.Text
  photoUrl       String?
  publicId       String?
  order          Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  principalFor   Settings[]

  @@index([status, group, order, id])
  @@index([publicId])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// Tracks unfinished uploads and retries failed Cloudinary deletions.
model MediaCleanup {
  publicId String @id
  notBefore DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([notBefore])
}
